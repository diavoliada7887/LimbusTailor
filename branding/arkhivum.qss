/* Arkhivum — LimbusTailor light theme */
QWidget {
    background-color: #F7F3ED;
    color: #112A46;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10pt;
    selection-background-color: #B85C38;
    selection-color: #F7F3ED;
}
QMainWindow, QDialog { background-color: #F7F3ED; }
QMenuBar {
    background-color: #112A46;
    color: #F7F3ED;
    border: 0;
    padding: 3px 6px;
}
QMenuBar::item { background: transparent; padding: 6px 10px; border-radius: 3px; }
QMenuBar::item:selected, QMenuBar::item:pressed { background-color: #B85C38; color: #F7F3ED; }
QMenu { background-color: #F7F3ED; color: #112A46; border: 1px solid #E7D7C2; padding: 5px; }
QMenu::item { padding: 6px 24px 6px 10px; border-radius: 3px; }
QMenu::item:selected { background-color: #E7D7C2; color: #112A46; }
QMenu::separator { height: 1px; background: #E7D7C2; margin: 5px 8px; }
QToolBar { background-color: #E7D7C2; border: 0; border-bottom: 1px solid #D4C1A8; spacing: 4px; padding: 4px; }
QToolBar QToolButton { background: transparent; color: #112A46; border: 1px solid transparent; border-radius: 4px; padding: 5px; }
QToolBar QToolButton:hover { background-color: #F7F3ED; border-color: #D4C1A8; }
QToolBar QToolButton:pressed, QToolBar QToolButton:checked { background-color: #112A46; color: #F7F3ED; }
QPushButton {
    background-color: #112A46;
    color: #F7F3ED;
    border: 1px solid #112A46;
    border-radius: 5px;
    padding: 6px 13px;
    min-height: 20px;
    font-weight: 600;
}
QPushButton:hover { background-color: #183A60; border-color: #183A60; }
QPushButton:pressed, QPushButton:default { background-color: #B85C38; border-color: #B85C38; }
QPushButton:disabled { background-color: #D8D0C5; color: #91877A; border-color: #D8D0C5; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #FFFCF7;
    color: #112A46;
    border: 1px solid #CDBDAA;
    border-radius: 4px;
    padding: 4px 6px;
    min-height: 20px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #B85C38; }
QComboBox { padding-right: 20px; }
QComboBox::drop-down { border: 0; width: 20px; }
QComboBox QAbstractItemView { background-color: #FFFCF7; color: #112A46; border: 1px solid #CDBDAA; selection-background-color: #E7D7C2; selection-color: #112A46; }
QGroupBox {
    background-color: #FFFCF7;
    border: 1px solid #D6C7B5;
    border-radius: 6px;
    margin-top: 15px;
    padding: 11px 8px 8px 8px;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 600;
    color: #112A46;
}
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 10px; padding: 0 5px; background-color: #F7F3ED; color: #112A46; }
QGroupBox QLabel, QGroupBox QCheckBox, QGroupBox QRadioButton, QGroupBox QLineEdit, QGroupBox QSpinBox, QGroupBox QDoubleSpinBox, QGroupBox QComboBox, QGroupBox QPushButton {
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-weight: normal;
}
QGroupBox#archiveOutputBox, QGroupBox#contentDetectionTuningBox, QGroupBox#contentPaddingBox, QGroupBox#physicalPageBox {
    border-left: 4px solid #B85C38;
    background-color: #FFFDFC;
}
QCheckBox, QRadioButton { spacing: 7px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 15px; height: 15px; }
QCheckBox::indicator:unchecked { background-color: #FFFCF7; border: 1px solid #A99A88; border-radius: 3px; }
QCheckBox::indicator:checked { background-color: #B85C38; border: 1px solid #B85C38; border-radius: 3px; }
QRadioButton::indicator:unchecked { background-color: #FFFCF7; border: 1px solid #A99A88; border-radius: 8px; }
QRadioButton::indicator:checked { background-color: #B85C38; border: 4px solid #F7F3ED; border-radius: 8px; }
QTabWidget::pane { border: 1px solid #D6C7B5; background-color: #FFFCF7; }
QTabBar::tab { background-color: #E7D7C2; color: #112A46; border: 1px solid #D6C7B5; border-bottom: 0; padding: 7px 12px; margin-right: 2px; }
QTabBar::tab:selected { background-color: #112A46; color: #F7F3ED; }
QTabBar::tab:hover:!selected { background-color: #F0E4D5; }
QListView, QTreeView, QTableView, QListWidget, QTreeWidget, QTableWidget {
    background-color: #FFFCF7;
    alternate-background-color: #F4EDE4;
    color: #112A46;
    border: 1px solid #D6C7B5;
    gridline-color: #E7D7C2;
    outline: 0;
}
QAbstractItemView::item:selected { background-color: #E7D7C2; color: #112A46; }
QAbstractItemView::item:selected:active { background-color: #B85C38; color: #F7F3ED; }
QHeaderView::section { background-color: #E7D7C2; color: #112A46; border: 0; border-right: 1px solid #D4C1A8; border-bottom: 1px solid #D4C1A8; padding: 5px 7px; font-weight: 600; }
QSplitter::handle { background-color: #D6C7B5; }
QScrollBar:vertical { background: #EFE7DC; width: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #9A8E80; min-height: 28px; border-radius: 5px; margin: 2px; }
QScrollBar::handle:vertical:hover { background: #B85C38; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #EFE7DC; height: 12px; margin: 0; }
QScrollBar::handle:horizontal { background: #9A8E80; min-width: 28px; border-radius: 5px; margin: 2px; }
QScrollBar::handle:horizontal:hover { background: #B85C38; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QProgressBar { background-color: #E7D7C2; color: #112A46; border: 1px solid #D6C7B5; border-radius: 4px; text-align: center; }
QProgressBar::chunk { background-color: #B85C38; border-radius: 3px; }
QStatusBar { background-color: #112A46; color: #F7F3ED; border: 0; }
QStatusBar QLabel { background: transparent; color: #F7F3ED; }
QToolTip { background-color: #112A46; color: #F7F3ED; border: 1px solid #B85C38; padding: 5px; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #D6C7B5; }
