+    }
+
+    const LinearFit left = fitLine(leftPts, true);
+    const LinearFit right = fitLine(rightPts, true);
+    const LinearFit top = fitLine(topPts, false);
+    const LinearFit bottom = fitLine(bottomPts, false);
+    if (!left.valid || !right.valid || !top.valid || !bottom.valid) {
+        return QPolygonF();
+    }
+
+    QPolygonF poly;
+    poly << intersectVerticalHorizontal(left, top)
+         << intersectVerticalHorizontal(right, top)
+         << intersectVerticalHorizontal(right, bottom)
+         << intersectVerticalHorizontal(left, bottom);
+
+    const QRectF bounds = poly.boundingRect();
+    if (!bounds.isValid() || bounds.width() < w * 0.25 || bounds.height() < h * 0.25
+        || bounds.left() < -w * 0.1 || bounds.top() < -h * 0.1
+        || bounds.right() > w * 1.1 || bounds.bottom() > h * 1.1) {
+        return QPolygonF();
+    }
+
+    if (scale < 1.0) {
+        QTransform back;
+        back.scale(1.0 / scale, 1.0 / scale);
+        poly = back.map(poly);
+    }
+    return poly;
+}
+
+Qt::GlobalColor archiveMarginFillColor()
+{
+    QSettings settings;
+    const QString fillName = settings.value(
+        _key_margins_fill_color, _key_margins_fill_color_def
+    ).toString().toUpper();
+    return fillName == QLatin1String("BLACK") ? Qt::black : Qt::white;
+}
+
+void protectScannerBackground(QImage& image, Qt::GlobalColor fillColor)
+{
+    QSettings settings;
+    const double paddingMm = settings.value(
+        _key_content_sel_content_padding_mm, _key_content_sel_content_padding_mm_def
+    ).toDouble();
+    if (paddingMm <= 0.0 || image.isNull()) {
+        return;
+    }
+
+    const QPolygonF page = detectPhysicalPagePolygon(image);
+    if (page.size() != 4) {
+        return;
+    }
+
+    QPainterPath outside;
+    outside.setFillRule(Qt::OddEvenFill);
+    outside.addRect(QRectF(image.rect()));
+    QPainterPath inside;
+    inside.addPolygon(page);
+    inside.closeSubpath();
+    outside.addPath(inside);
+
+    QPainter painter(&image);
+    painter.setRenderHint(QPainter::Antialiasing, false);
+    painter.fillPath(outside, fillColor);
+}
+
+void fillArchiveLayoutMargins(QImage& image, QRect const& contentRect, Qt::GlobalColor fillColor)
+{
+    if (image.isNull()) {
+        return;
+    }
+    const QRect clippedContent = contentRect.intersected(image.rect());
+    QPainterPath outside;
+    outside.setFillRule(Qt::OddEvenFill);
+    outside.addRect(QRectF(image.rect()));
+    if (!clippedContent.isEmpty()) {
+        outside.addRect(QRectF(clippedContent));
+    }
+    QPainter painter(&image);
+    painter.setRenderHint(QPainter::Antialiasing, false);
+    painter.fillPath(outside, fillColor);
+}
