diff --git a/src/core/filters/output/OptionsWidget.cpp b/src/core/filters/output/OptionsWidget.cpp
index 46f19e0..1e8d0b3 100644
--- a/src/core/filters/output/OptionsWidget.cpp
+++ b/src/core/filters/output/OptionsWidget.cpp
@@ -63,6 +63,37 @@ OptionsWidget::OptionsWidget(
 {
     setupUi(this);
 
+    // ScanTailor Archive: final format belongs to the Output stage.
+    QSettings archiveSettings;
+    archiveOutputFormat->addItem(QStringLiteral("TIFF"));
+    archiveOutputFormat->addItem(QStringLiteral("JPEG"));
+    archiveOutputFormat->addItem(QStringLiteral("PNG"));
+    const QString archiveFormat = archiveSettings.value(
+        _key_output_image_format, _key_output_image_format_def
+    ).toString().toUpper();
+    const int archiveFormatIndex = archiveOutputFormat->findText(archiveFormat);
+    archiveOutputFormat->setCurrentIndex(archiveFormatIndex >= 0 ? archiveFormatIndex : 0);
+    archiveJpegQuality->setValue(archiveSettings.value(
+        _key_output_jpeg_quality, _key_output_jpeg_quality_def
+    ).toInt());
+    archiveJpegQuality->setEnabled(
+        archiveOutputFormat->currentText() == QLatin1String("JPEG")
+    );
+
+    connect(archiveOutputFormat, &QComboBox::currentTextChanged, this, [](QString const& format) {
+        QSettings settings;
+        settings.setValue(_key_output_image_format, format.toUpper());
+        GlobalStaticSettings::updateSettings();
+    });
+    connect(archiveOutputFormat, &QComboBox::currentTextChanged, this, [this](QString const& format) {
+        archiveJpegQuality->setEnabled(format == QLatin1String("JPEG"));
+    });
+    connect(archiveJpegQuality, QOverload<int>::of(&QSpinBox::valueChanged), this, [](int quality) {
+        QSettings settings;
+        settings.setValue(_key_output_jpeg_quality, quality);
+        GlobalStaticSettings::updateSettings();
+    });
+
     setDespeckleLevel(DESPECKLE_NORMAL);
 
     depthPerceptionSlider->setMinimum(qRound(DepthPerception::minValue() * 10));
