+void
+OptionsWidget::contentDetectionSettingsChanged()
+{
+    QSettings settings;
+    QString cleanup = QStringLiteral("NORMAL");
+    if (contentCleanup->currentIndex() == 0) {
+        cleanup = QStringLiteral("CAUTIOUS");
+    } else if (contentCleanup->currentIndex() == 2) {
+        cleanup = QStringLiteral("AGGRESSIVE");
+    }
+    settings.setValue(_key_content_sel_cleanup_level, cleanup);
+    settings.setValue(_key_content_sel_wolf_lower_bound, contentWolfThreshold->value());
+
+    if (m_uiData.contentDetection() && m_uiData.mode() == MODE_AUTO) {
+        commitCurrentParams();
+        emit reloadRequested();
+    }
+}
+
 void
 OptionsWidget::updateModeIndication(AutoManualMode const mode)
 {
