+QRectF
+Settings::typicalContentFrame(int min_samples) const
+{
+    QMutexLocker locker(&m_mutex);
+
+    std::vector<double> lefts;
+    std::vector<double> tops;
+    std::vector<double> rights;
+    std::vector<double> bottoms;
+    lefts.reserve(m_pageParams.size());
+    tops.reserve(m_pageParams.size());
+    rights.reserve(m_pageParams.size());
+    bottoms.reserve(m_pageParams.size());
+
+    for (PageParams::const_reference kv : m_pageParams) {
+        Params const& params = kv.second;
+        QRectF const page(params.pageRect());
+        QRectF const content(params.contentRect());
+        if (params.mode() != MODE_AUTO || !params.isContentDetectionEnabled() ||
+            !page.isValid() || page.isEmpty() || !content.isValid() || content.isEmpty() ||
+            page.width() <= 0.0 || page.height() <= 0.0) {
+            continue;
+        }
+
+        QRectF const clipped(content.intersected(page));
+        if (!clipped.isValid() || clipped.isEmpty()) {
+            continue;
+        }
+
+        lefts.push_back(qBound(0.0, (clipped.left() - page.left()) / page.width(), 1.0));
+        tops.push_back(qBound(0.0, (clipped.top() - page.top()) / page.height(), 1.0));
+        rights.push_back(qBound(0.0, (clipped.right() - page.left()) / page.width(), 1.0));
+        bottoms.push_back(qBound(0.0, (clipped.bottom() - page.top()) / page.height(), 1.0));
+    }
+
+    if (static_cast<int>(lefts.size()) < min_samples) {
+        return QRectF();
+    }
+
+    auto median = [](std::vector<double>& values) -> double {
+        std::sort(values.begin(), values.end());
+        const size_t n = values.size();
+        if (n % 2) {
+            return values[n / 2];
+        }
+        return (values[n / 2 - 1] + values[n / 2]) * 0.5;
+    };
+
+    const double left = median(lefts);
+    const double top = median(tops);
+    const double right = median(rights);
+    const double bottom = median(bottoms);
+    if (right <= left || bottom <= top) {
+        return QRectF();
+    }
+
+    // Normalized to page coordinates, so the typical frame has a stable
+    // position even when source pages have slightly different pixel sizes.
+    return QRectF(left, top, right - left, bottom - top);
+}
