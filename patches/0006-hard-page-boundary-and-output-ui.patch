+class OrderByScannerBackground : public PageOrderProvider
+{
+public:
+    explicit OrderByScannerBackground(IntrusivePtr<Settings> const& settings)
+        : m_settings(settings) {}
+
+    bool precedes(PageId const& lhs, bool lhs_incomplete,
+                  PageId const& rhs, bool rhs_incomplete) const override
+    {
+        if (lhs_incomplete != rhs_incomplete) {
+            return !lhs_incomplete;
+        }
+        const double ls = score(lhs);
+        const double rs = score(rhs);
+        if (ls != rs) {
+            return ls > rs;
+        }
+        return lhs < rhs;
+    }
+
+    QString hint(PageId const& page) const override
+    {
+        std::unique_ptr<OutputParams> params(m_settings->getOutputParams(page));
+        if (!params) {
+            return QObject::tr("not processed");
+        }
+        return QObject::tr("scanner background: %1%").arg(
+            params->archiveScannerBackgroundScore(), 0, 'f', 2
+        );
+    }
+
+private:
+    double score(PageId const& page) const
+    {
+        std::unique_ptr<OutputParams> params(m_settings->getOutputParams(page));
+        return params ? params->archiveScannerBackgroundScore() : -1.0;
+    }
+
+    IntrusivePtr<Settings> m_settings;
+};
+}
