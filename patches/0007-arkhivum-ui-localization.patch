diff --git a/src/app/main.cpp b/src/app/main.cpp
--- a/src/app/main.cpp
+++ b/src/app/main.cpp
@@ -74,2 +74,17 @@ int main(int argc, char** argv)
     QSettings settings;
+    if (!settings.value(QStringLiteral("main_window/arkhivum_theme_initialized"), false).toBool()) {
+#ifdef _WIN32
+        const QString arkhivumQss = QDir(app.applicationDirPath()).filePath(
+            QStringLiteral("stylesheets/arkhivum.qss")
+        );
+#else
+        const QString arkhivumQss = QDir(QString::fromUtf8(STYLESHEETS_DIR_ABS)).filePath(
+            QStringLiteral("arkhivum.qss")
+        );
+#endif
+        settings.setValue(_key_app_style, QStringLiteral("fusion"));
+        settings.setValue(_key_app_stylsheet_file, arkhivumQss);
+        settings.setValue(_key_app_empty_palette, false);
+        settings.setValue(QStringLiteral("main_window/arkhivum_theme_initialized"), true);
+    }
     GlobalStaticSettings::applyAppStyle(settings);
