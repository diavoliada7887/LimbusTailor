+namespace
+{
+bool writeFinalOutputImage(QString const& filePath, QImage const& image, QString* tiffCompressionUsed)
+{
+    const QString format = GlobalStaticSettings::m_output_image_format;
+    if (format == QLatin1String("JPEG") || format == QLatin1String("JPG")) {
+        QImageWriter writer(filePath, "jpeg");
+        writer.setQuality(GlobalStaticSettings::m_output_jpeg_quality);
+        return writer.write(image);
+    }
+    if (format == QLatin1String("PNG")) {
+        QImageWriter writer(filePath, "png");
+        return writer.write(image);
+    }
+    return TiffWriter::writeImage(filePath, image, false, 0, tiffCompressionUsed);
+}
+}
