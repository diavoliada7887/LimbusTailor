+void
+OptionsWidget::contentPaddingChanged(double value)
+{
+    QSettings().setValue(_key_content_sel_content_padding_mm, value);
+
+    // ScanTailor Archive: go through ScanTailor's native Select Content
+    // regeneration path.  commitCurrentParams() deliberately stores empty
+    // Dependencies(), exactly like the existing page-border controls do.
+    // On reload Task::process() therefore rebuilds the AUTO content box and
+    // applies the requested safety area to a fresh detector result instead of
+    // silently reusing the old cached rectangle.
+    if (m_uiData.contentDetection() && m_uiData.mode() == MODE_AUTO) {
+        commitCurrentParams();
+        emit reloadRequested();
+    }
+}
